+// ===== W7 macos 集成（build/squirrel-w7.patch 注入；实现件见 macos/w7/）=====
+extension SquirrelInputController {
+  /// W7 (a): 语音转写结果上屏（PTT 松开 → voice/mic 管线 → commit）
+  func w7CommitVoiceText(_ text: String) {
+    commit(string: text)
+  }
+
+  /// W7 (a): 面板状态提示（低置信重说 / 取消 / 错误 / 识别中）
+  func w7ShowVoiceStatus(_ message: String) {
+    if let panel = NSApp.squirrelAppDelegate.panel {
+      panel.updateStatus(long: message, short: message)
+      panel.update(preedit: "", selRange: .empty, caretPos: 0,
+                   candidates: [], comments: [], labels: [],
+                   highlighted: -1, page: 0, lastPage: true, update: true)
+    }
+  }
+
+  /// W7 (a): 录音中提示（面板 preedit 行，不写客户端 marked text）
+  func w7ShowRecordingHint() {
+    showPanel(preedit: "🎙 正在聆听…（松开上屏 · Esc 取消）",
+              selRange: NSRange(location: 0, length: 0), caretPos: 0,
+              candidates: [], comments: [], labels: [],
+              highlighted: -1, page: 0, lastPage: true)
+  }
+
+  /// W7: 恢复面板为当前 rime 状态（录音结束后）
+  func w7RefreshPanel() {
+    rimeUpdate()
+  }
+
+  /// W7 (b): 候选链 AI 重排挂点——常规组立即上屏（不等 AI、不阻塞），
+  /// 异步 rescore（TimeoutAssist 800ms 弃本轮不阻塞上屏，审计每轮恰一条）；
+  /// 智能组到达后合并重绘。候选区两组可区分：常规组原标签（1..8）+
+  /// 智能组「智1..K」标签与 ⚡AI 评论（accent 高亮）。
+  func w7ShowWithRescore(preedit: String, selRange: NSRange, caretPos: Int,
+                         candidates: [String], comments: [String], labels: [String],
+                         highlighted: Int, page: Int, lastPage: Bool) {
+    w7Generation += 1
+    let gen = w7Generation
+    w7RegularCandidates = candidates
+    w7RegularComments = comments
+    w7RegularLabels = labels
+    w7DisplayToRime = Array(0..<candidates.count)
+    showPanel(preedit: preedit, selRange: selRange, caretPos: caretPos,
+              candidates: candidates, comments: comments, labels: labels,
+              highlighted: highlighted, page: page, lastPage: lastPage)
+    guard W7PttController.rescoreEnabled, !candidates.isEmpty else { return }
+    W7RescoreBridge.shared().rescore(withPreedit: preedit, textBefore: "",
+                                     candidates: candidates) { [weak self] status, smartOrder in
+      DispatchQueue.main.async {
+        self?.w7MergeSmart(status: status, smartOrder: smartOrder, generation: gen,
+                           preedit: preedit, selRange: selRange, caretPos: caretPos,
+                           highlighted: highlighted, page: page, lastPage: lastPage)
+      }
+    }
   }
 
+  private func w7MergeSmart(status: W7RescoreStatus, smartOrder: [String], generation: Int,
+                            preedit: String, selRange: NSRange, caretPos: Int,
+                            highlighted: Int, page: Int, lastPage: Bool) {
+    guard generation == w7Generation else { return }  // 用户已继续打字：本轮过期，丢弃
+    guard status == .ok, !smartOrder.isEmpty else { return }  // 弃本轮/拒绝/错误：保持常规组
+    let regular = w7RegularCandidates
+    var firstIndex: [String: Int] = [:]
+    for (i, text) in regular.enumerated() where firstIndex[text] == nil {
+      firstIndex[text] = i
+    }
+    var texts = regular
+    var comments = w7RegularComments
+    var labels = w7RegularLabels
+    var displayToRime = Array(0..<regular.count)
+    var smartIndices = Set<Int>()
+    let topK = min(W7PttController.smartTopK, smartOrder.count)
+    for (k, text) in smartOrder.prefix(topK).enumerated() {
+      guard let rimeIndex = firstIndex[text] else { continue }  // C++ group() 已滤越界，双保险
+      texts.append(text)
+      comments.append("⚡AI")
+      labels.append("智\(k + 1)")
+      displayToRime.append(rimeIndex)
+      smartIndices.insert(texts.count - 1)
+    }
+    guard texts.count > regular.count else { return }
+    w7DisplayToRime = displayToRime
+    specialCommentIndices[.commentHighlight] = smartIndices  // 智能组评论 accent 高亮
+    showPanel(preedit: preedit, selRange: selRange, caretPos: caretPos,
+              candidates: texts, comments: comments, labels: labels,
+              highlighted: highlighted, page: page, lastPage: lastPage)
+  }
 }
